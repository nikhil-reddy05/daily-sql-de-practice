# === Option 1: Sign in with ChatGPT (recommended) ===
# No API key needed! Just run the app and click "Sign in with ChatGPT".
# AI calls run against your own ChatGPT Plus/Pro subscription quota.
#
# Optional:
# Public URL of this app (only needed if NOT using the default loopback flow,
# e.g. hosting for others). Default: http://127.0.0.1:<PORT>/api/auth/callback
# APP_URL=
#
# Model for ChatGPT-plan calls (default: gpt-5-mini)
# AI_MODEL=gpt-5-mini
#
# Stable encryption key for stored OAuth tokens (any string; hashed to 32 bytes).
# If missing, a random key is generated and stored in data/app.db (warned at boot).
# TOKENS_KEY=
#
# Secret for signing session cookies. If missing, one is generated (warned at boot).
# SESSION_SECRET=

# === Option 2: API key fallback (no Plus/Pro? use this) ===
# Which provider to use: openai | anthropic | custom
AI_PROVIDER=

# API key for the provider (required for all providers)
AI_API_KEY=

# Model name (optional — sensible defaults below; override as you like)
#   openai default:    gpt-4o-mini
#   anthropic default: claude-haiku-4-5
#   custom default:    llama3.1
# AI_MODEL=

# Base URL (optional for openai/anthropic; REQUIRED for custom)
#   Ollama (free, local):      http://localhost:11434/v1   (run: ollama pull llama3.1)
#   OpenRouter:                https://openrouter.ai/api/v1
#   LM Studio:                 http://localhost:1234/v1
#   Any OpenAI-compatible API: https://your-endpoint/v1
AI_BASE_URL=

# Server port (optional, default 3000)
PORT=3000
